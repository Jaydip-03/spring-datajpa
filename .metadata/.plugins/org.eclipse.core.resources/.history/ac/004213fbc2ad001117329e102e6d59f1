<%@ page contentType="text/html;charset=UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core"%>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Student Details</title>

<body>
	
	<h1>
		Sell all Student info 
	</h1>
	
	<c:forEach items="${all}" var="std">
		<div>
			<h5>Id : ${std.getId()} </h5>
			Name : ${std.getName()}
			Age : ${std.getAge()}
		</div>
		
	</c:forEach>
	
</body>
</html>