<%@ page contentType="text/html;charset=UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core"%>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Student Details</title>

<body>
	
	<h1>
		See all Student info 
	</h1>
	
	<c:forEach items="${all}" var="std">
		<div style="border: 2px solid black; ">
			Id : ${std.getId()} <br>
			Name : ${std.getName()} <br>
			Email : ${std.getEmail()}
			Age : ${std.getAge()} <br>
			Mobile : ${std.getMobile()} <br> 
			Gender : ${std.getGender()} <br>
			City : ${std.getCity()} <br> 
			Course : ${std.getCourse()} <br> 
			Percenatage :${std.getPercentage()} <br>
			
			<a href="update?id=${std.getId()}">Update</a>
			<a href="delete?id=${std.getId()}">Delete</a>
			
			
		</div>
		
	</c:forEach>
	
</body>
</html>