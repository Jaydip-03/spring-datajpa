package com.jsp.sms.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.servlet.ModelAndView;

import com.jsp.sms.entity.Student;
import com.jsp.sms.service.StudentService;

@Controller
public class StudentController {
	
	@Autowired
	private StudentService service ;
	
	
	@GetMapping("/")
	public String showLoginPage() {
		
		return "WelcomePage" ;
	}
	
	@GetMapping("/registerPage")
	public String showRegistrationPage() {
		
		return "register" ;
	}
	
	
	@PostMapping("/loginVal")
	public String loginValidation(@RequestParam String email, @RequestParam long contact) {
		System.out.println(email) ;
		System.out.println(contact);
		
		if(service.emailValid(email, contact))
			return "redirect:dash";
		else
		    return "redirect:/" ;
	}
	
	
	@PostMapping("/register")
	public String saveStudent(@ModelAttribute Student student) {
		
	System.out.println(student) ;
	service.saveStudent(student) ;
		
		return "redirect:dash" ;
	}
	
	
	@GetMapping("/dash")
	public String showDashboard() {
		
		return "dashboard" ;
	}
	
	
	@GetMapping("/display")
	public ModelAndView showAllStudent(ModelAndView mav) {
		
		List<Student> stdList = service.getAllStudent() ;
		mav.addObject("students", stdList) ;
		mav.setViewName("display") ;
		
		return mav ;
	}
	
	
	@GetMapping("/search")
	public String searchStudentByName(@RequestParam String searchName, Model model) {
		
		List<Student> stdList = service.getStudentByName(searchName) ;
		
		model.addAttribute("students", stdList) ;
		
		return "display" ;
			
		
	}
	
	
	@GetMapping("/deleteAll")
	public void deleteAllStd() {
		
		service.deleteAllStudent() ;
	}
	
	
	

}
