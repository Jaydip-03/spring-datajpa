package com.jsp.emp.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.servlet.ModelAndView;

import com.jsp.emp.entity.Employee;
import com.jsp.emp.repository.EmployeeRepo;

@Controller
public class EmployeeController {
	
	@Autowired
	private EmployeeRepo empr ;
	
	
	@GetMapping("/")
	public String register() {
		
		return "register" ;
	}
	
	
	@PostMapping("/save")
	public ModelAndView saveEmp(@ModelAttribute Employee emp , ModelAndView mav) {
		
		 empr.save(emp) ;
		 
		 mav.setViewName("home") ;
		
		return mav ;
		
	}
	
	@GetMapping("/home")
	public String home() {
		return "home" ;
	}
	
	@GetMapping("/displayEmp")
	public String displayAllEmp(Model model) {
		
		List<Employee> all = empr.findAll() ;
		model.addAttribute("all", all) ;
		
		return "display" ;
		
	}
	
	
	@GetMapping("/update")
	public String updateEmployee(@RequestParam int  id, Model model) {
		
		Employee emp = empr.findById(id).get() ;
		
		model.addAttribute("emp", emp) ;
		
		
		return "updateEmployee" ;
	}
	
	
	@PostMapping("/editEmp")
	public String editEmployee(@ModelAttribute Employee emp ) {
		
		empr.save(emp) ;
		
		return "redirect:home" ;
	}
	
	
	@GetMapping("/delete")
	public String deleteEmployee(@RequestParam int id) {
		
		empr.deleteById(id);
		
		return "redirect:displayEmp" ;
	}
	
	
	@GetMapping("/serchEmp")
	public String serchEmpByName(@RequestParam String search, Model model) {
		
		List<Employee> empByName = empr.findEmpByName(search) ;
		System.out.println(empByName) ;
		model.addAttribute("all", empByName) ;
		
		return "display" ;
		
	}

}
