package com.jsp.emp.controller;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.servlet.ModelAndView;

import com.jsp.emp.entity.Employee;
import com.jsp.emp.repository.EmployeeRepo;

@Controller
public class EmployeeController {
	
	@Autowired
	private EmployeeRepo empr ;
	
	
	@GetMapping("/")
	public String register() {
		
		return "register" ;
	}
	
	
	public ModelAndView saveEmp(@ModelAttribute Employee emp , ModelAndView mav) {
		
		 empr.save(emp) ;
		 
		 mav.setViewName("home") ;
		
		return mav ;
		
		
	}

}
